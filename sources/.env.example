# OneDay Curriculum v3.1 — 환경변수 양식
#
# 본 파일을 .env 로 복사하여 사용한다.
# 절대 .env 파일을 git에 커밋하지 않는다. (.gitignore 확인)

# === OpenAI ===
# CrewAI의 LLM 호출에 사용된다 (Codex CLI 크레딧과 별개).
OPENAI_API_KEY=sk-...

# 사용 모델 — 기본값은 gpt-4o. 비용 절감 시 gpt-4o-mini로 변경.
OPENAI_MODEL=gpt-4o

# === LangSmith (M6 운영 관찰성) ===
# https://smith.langchain.com 에서 무료 계정 발급 후 키 생성.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=build-triage-curriculum

# === Anthropic Claude Code (선택) ===
# Claude Code CLI 인증과 별개. 일부 실습에서 API로 호출할 경우 사용.
ANTHROPIC_API_KEY=sk-ant-...

# === MCP 서버 (M6 MCP 실습) ===
# Filesystem MCP 서버의 접근 허용 루트.
MCP_FILESYSTEM_ROOT=./crew

# === Slack (M6 통합본) ===
# slack_notifier @tool 에서 사용된다.
SLACK_BOT_TOKEN=xoxb-...
SLACK_DEFAULT_CHANNEL=#build-triage
